# Nyaya AI Production Environment Template
# NEVER COMMIT REAL PRODUCTION SECRETS TO GIT

APP_ENV=production
RELEASE_ID=git-commit-sha-here

# Auth Security (Minimum 32 random bytes)
JWT_SECRET=replace_with_secure_random_32_byte_token

# MongoDB Production
MONGODB_URL=mongodb+srv://prod_user:prod_password@prod-cluster.mongodb.net/nyaya_prod?retryWrites=true&w=majority
MONGODB_DATABASE=nyaya_prod

# Private Object Storage
STORAGE_BACKEND=s3
REQUIRE_OBJECT_STORAGE_IN_PRODUCTION=true
OBJECT_STORAGE_BUCKET=nyaya-private-evidence-prod
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=replace_with_iam_access_key
OBJECT_STORAGE_SECRET_KEY=replace_with_iam_secret_key
SIGNED_URL_EXPIRE_SECONDS=300

# Shared Rate Limiting (Redis)
RATE_LIMIT_BACKEND=redis
REQUIRE_SHARED_RATE_LIMITER_IN_PRODUCTION=true
REDIS_URL=redis://redis-user:redis-password@prod-redis.internal:6379/0

# Malware Scanning
MALWARE_SCANNER_TYPE=clamav
REQUIRE_REAL_MALWARE_SCANNER_IN_PRODUCTION=true
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310

# External LLM & Legal RAG Services
LLM_API_KEY=replace_with_production_llm_api_key

# Host & Origin Boundaries
CORS_ALLOWED_ORIGINS=https://nyaya.ai,https://app.nyaya.ai
ALLOWED_HOSTS=nyaya.ai,app.nyaya.ai
