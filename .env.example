# Indian Legal Assistance Platform - Environment Configuration Template
# Copy this file to .env before starting the services.

# Application Settings
APP_NAME="Indian Legal Assistance & Documentation Platform"
APP_VERSION=1.0.0
ENVIRONMENT=development

# Server & Network
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database (MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=ai_legal_assistance

# Redis (Job Queue & Cache)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_secure_random_32_byte_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM & RAG Provider Configuration
LLM_PROVIDER=openrouter  # Options: openrouter, openai, mock
LLM_API_KEY=your_api_key_here
LLM_MODEL=anthropic/claude-3-5-sonnet  # Pinned production model

# Retrieval & Hybrid Search
MIN_SIMILARITY_THRESHOLD=0.45
ENABLE_HYBRID_SEARCH=true

# Storage Abstraction
STORAGE_PROVIDER=local  # Options: local, s3
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# S3 Configuration (Used if STORAGE_PROVIDER=s3)
S3_BUCKET_NAME=legal-evidence-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Processing Limits
MAX_PDF_PAGES=50
OCR_TIMEOUT_SECONDS=60
